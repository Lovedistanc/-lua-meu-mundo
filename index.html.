<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#100d18">
<title>Lua × Meu Mundo — nosso cantinho</title>
<style>
:root{--bg:#100d18;--panel:#191425;--panel2:#211a30;--am:#b69ae8;--am2:#8c69c8;--pearl:#f4edf7;--muted:#b8adbf;--line:#ffffff18}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(ellipse at 50% -15%,#483064 0,transparent 48%),var(--bg);color:var(--pearl);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;min-height:100vh}
body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.25;background-image:radial-gradient(1px 1px at 12% 18%,#fff 99%,transparent),radial-gradient(1px 1px at 82% 27%,#e8d9ff 99%,transparent),radial-gradient(1px 1px at 64% 72%,#fff 99%,transparent);background-size:230px 210px}
.wrap{width:min(920px,92%);margin:auto;position:relative}.top{display:flex;justify-content:space-between;align-items:center;padding:23px 0;color:var(--muted);font-size:11px;letter-spacing:.16em;text-transform:uppercase}.brand{color:var(--pearl);font-weight:800}.pill{border:1px solid var(--line);border-radius:99px;padding:8px 12px;color:var(--am)}
.hero{min-height:76vh;display:grid;place-items:center;text-align:center;padding:45px 0 65px}.eyebrow,.section-label{color:var(--am);font-size:11px;letter-spacing:.22em;text-transform:uppercase}.heart{font-size:43px;color:var(--am);text-shadow:0 0 30px #b69ae877;margin:20px 0;animation:pulse 2.2s infinite}@keyframes pulse{50%{transform:scale(1.1)}}h1{font-size:clamp(40px,8vw,72px);line-height:1.03;letter-spacing:-.055em;margin:0 auto 18px;max-width:760px}h1 span{color:var(--am)}.intro{max-width:570px;color:var(--muted);font-size:16px;line-height:1.8;margin:0 auto 26px}.btn{border:0;border-radius:13px;padding:14px 20px;background:linear-gradient(135deg,#c9b2f0,#9875ce);color:#171020;font-weight:800;font-size:13px;cursor:pointer;transition:.2s}.btn:hover{transform:translateY(-2px);filter:brightness(1.08)}.btn.secondary{background:#ffffff0b;color:var(--pearl);border:1px solid #b69ae855}.hint{font-size:11px;color:#8e8298;margin-top:14px}
section{padding:40px 0;scroll-margin-top:20px}.section-title{font-size:clamp(27px,5vw,40px);letter-spacing:-.04em;margin:10px 0 15px}.card{background:linear-gradient(145deg,#211a30ee,#171321ee);border:1px solid var(--line);border-radius:23px;padding:clamp(20px,5vw,34px);box-shadow:0 20px 70px #0003}.story{color:#d8cedf;line-height:1.9;font-size:15px}.story strong{color:var(--pearl)}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px;margin-top:22px}.tile{background:#ffffff08;border:1px solid var(--line);border-radius:17px;padding:18px}.tile .ico{font-size:24px;margin-bottom:11px}.tile h3{margin:0 0 7px;font-size:14px}.tile p{margin:0;color:var(--muted);font-size:12px;line-height:1.65}
.game-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:13px;margin-top:20px}.game{background:#ffffff08;border:1px solid var(--line);border-radius:18px;padding:18px}.game h3{margin:0 0 7px}.game p{color:var(--muted);font-size:13px;line-height:1.6;min-height:42px}.game-area{margin-top:15px;padding-top:15px;border-top:1px solid var(--line)}.small{font-size:12px;color:var(--muted);line-height:1.6}.choices{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.choice{border:1px solid #b69ae855;background:#b69ae811;color:var(--pearl);padding:10px 12px;border-radius:11px;cursor:pointer}.choice:hover{background:#b69ae833}.result{margin-top:12px;color:var(--am);font-size:13px;min-height:20px}.board{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;max-width:230px;margin:14px auto}.cell{aspect-ratio:1;border:1px solid #b69ae855;border-radius:12px;background:#ffffff08;color:var(--pearl);font-size:28px;cursor:pointer}.pet-wrap{display:grid;grid-template-columns:1fr 1.2fr;gap:20px;align-items:center}.pet-stage{background:radial-gradient(circle,#60477b55,transparent 68%),#ffffff08;border:1px solid var(--line);border-radius:20px;min-height:220px;display:grid;place-items:center;text-align:center}.pet{font-size:88px;filter:drop-shadow(0 8px 20px #0005);animation:bob 2s infinite ease-in-out}@keyframes bob{50%{transform:translateY(-7px)}}.stats{display:grid;gap:12px;margin:15px 0}.stat-head{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin-bottom:5px}.bar{height:8px;background:#ffffff14;border-radius:20px;overflow:hidden}.fill{height:100%;width:70%;background:linear-gradient(90deg,#8c69c8,#d5c2f4);border-radius:20px;transition:width .3s}.pet-actions{display:flex;gap:8px;flex-wrap:wrap}.pet-actions .choice{font-size:12px}.notice{border:1px solid #b69ae844;background:#b69ae811;color:#d8c9ec;border-radius:13px;padding:12px;font-size:12px;line-height:1.6;margin-top:15px}
.secret{display:none;margin-top:18px;padding:20px;border-radius:16px;background:#b69ae812;border:1px solid #b69ae844;line-height:1.8}.secret.show{display:block;animation:fade .5s}@keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
footer{text-align:center;padding:50px 0 30px;color:#92869d;font-size:11px;letter-spacing:.08em}
@media(max-width:650px){.grid{grid-template-columns:1fr}.game-grid,.pet-wrap{grid-template-columns:1fr}.hero{min-height:72vh}.top{font-size:9px}.intro{font-size:14px}.pet-stage{min-height:180px}}
</style></head>
<body><div class="wrap">
<header class="top"><div class="brand">LUA <span style="color:var(--am)">×</span> MEU MUNDO</div><div class="pill">✦ nosso universo</div></header>
<main>
<div class="hero"><div><div class="eyebrow">✦ acesso especial concedido ✦</div><div class="heart">♡</div><h1>Ei, <span>Guss.</span><br>bem-vindo ao<br>nosso universo.</h1><p class="intro">Preparei um cantinho com a nossa cara: um pouco de carinho, algumas brincadeiras e um pequeno companheiro para cuidarmos juntos.</p><button class="btn" onclick="document.getElementById('historia').scrollIntoView({behavior:'smooth'})">ENTRAR NO NOSSO UNIVERSO ↗</button><div class="hint">[ jogador 01: Guss &nbsp; • &nbsp; jogadora 02: Lua ]</div></div></div>
<section id="historia"><div class="section-label">01 / nossa história</div><div class="card"><h2 class="section-title">Às vezes, a melhor conexão<br>não precisa de Wi-Fi. ♡</h2><div class="story">No meio de tantas telas, jogos, conversas e caminhos diferentes, nossos mundos se encontraram.<br><br>Gosto de pensar que, entre tantas possibilidades, a vida escolheu essa: <strong>Lua e Meu Mundo.</strong><br><br>Este site é um jeitinho de guardar um pedacinho do nosso carinho e criar novas lembranças, uma fase de cada vez.</div></div></section>
<section><div class="section-label">02 / modo cooperativo</div><h2 class="section-title">Vamos jogar juntos?</h2><p class="small">Escolham uma brincadeira e dividam o mesmo dispositivo para jogar por turnos.</p>
<div class="game-grid">
<div class="game"><div class="ico">💜</div><h3>Quiz do casal</h3><p>Uma pergunta sobre vocês. Descubram se estão na mesma sintonia.</p><div class="game-area"><div id="quizQ" class="small">Qual apelido representa esse nosso cantinho?</div><div class="choices"><button class="choice" onclick="quiz('Lua & Meu Mundo')">Lua & Meu Mundo</button><button class="choice" onclick="quiz('Player 1 & Player 2')">Player 1 & Player 2</button><button class="choice" onclick="quiz('Dois astronautas')">Dois astronautas</button></div><div id="quizR" class="result"></div></div></div>
<div class="game"><div class="ico">⭕</div><h3>Jogo da velha</h3><p>Um começa com X e o outro joga com O. Quem fizer uma linha vence!</p><div class="game-area"><div id="turn" class="small" style="text-align:center">Vez de X</div><div class="board" id="board"></div><div style="text-align:center"><button class="choice" onclick="resetBoard()">Recomeçar partida</button></div><div id="boardR" class="result" style="text-align:center"></div></div></div>
<div class="game"><div class="ico">⚡</div><h3>Desafio relâmpago</h3><p>Respondam sem pensar muito. Vale rir, vale discutir e vale conhecer mais um pouquinho.</p><div class="game-area"><div id="challenge" class="small">Quem provavelmente dormiria durante um filme?</div><div class="choices"><button class="choice" onclick="nextChallenge('Guss')">Guss 😴</button><button class="choice" onclick="nextChallenge('Lua')">Lua 🌙</button><button class="choice" onclick="nextChallenge('Os dois')">Os dois 😂</button></div><div id="challengeR" class="result"></div></div></div>
<div class="game"><div class="ico">🧩</div><h3>Missão de carinho</h3><p>Uma missão simples para fazerem um ao outro sorrir hoje.</p><div class="game-area"><div id="mission" class="small">Toquem no botão para sortear uma missão.</div><div class="choices"><button class="choice" onclick="newMission()">Sortear missão ✨</button></div></div></div>
</div></section>
<section><div class="section-label">03 / nosso companheirinho</div><h2 class="section-title">Um bichinho para cuidar a dois.</h2><div class="card"><div class="pet-wrap"><div class="pet-stage"><div><div class="pet" id="petFace">🐱</div><div style="color:var(--am);font-weight:700;margin-top:8px">Ametista</div><div class="small">seu novo companheirinho</div></div></div><div><h3 style="margin-top:0">Como Ametista está?</h3><p class="small">Dê comidinha, brinque e faça carinho. Cada cuidado deixa o nosso bichinho mais feliz. ♡</p><div class="stats"><div><div class="stat-head"><span>🍓 Fome</span><span id="hungerN">70%</span></div><div class="bar"><div class="fill" id="hungerB"></div></div></div><div><div class="stat-head"><span>⚡ Energia</span><span id="energyN">70%</span></div><div class="bar"><div class="fill" id="energyB"></div></div></div><div><div class="stat-head"><span>💗 Carinho</span><span id="loveN">70%</span></div><div class="bar"><div class="fill" id="loveB"></div></div></div></div><div class="pet-actions"><button class="choice" onclick="care('feed')">🍓 Alimentar</button><button class="choice" onclick="care('play')">🧶 Brincar</button><button class="choice" onclick="care('love')">💗 Fazer carinho</button><button class="choice" onclick="care('sleep')">🌙 Descansar</button></div><div class="result" id="petMsg">Ametista está feliz por conhecer vocês!</div></div></div><div class="notice">Dica: vocês podem combinar de cuidar dela quando estiverem juntos. Nesta versão, o progresso fica salvo neste navegador e neste dispositivo.</div></div></section>
<section><div class="section-label">04 / recompensa secreta</div><div class="card" style="text-align:center"><div class="heart">✧</div><h2 class="section-title">Uma mensagem só sua.</h2><p class="small">Aperte para desbloquear a cartinha da sua Lua.</p><button class="btn" id="unlockBtn" onclick="reveal()">DESBLOQUEAR MENSAGEM ✦</button><div class="secret" id="secret">Guss, meu nerd favorito… ❤️<br><br>Fiz esse cantinho pensando em você. Queria que ele tivesse um pouquinho das coisas que você gosta e muito do carinho que tenho por você. Que a gente possa jogar, rir, cuidar do nosso bichinho e continuar criando lembranças, mesmo de longe.<br><br>Com carinho, da sua Lua. 🌙</div></div></section>
</main><footer>FEITO COM CARINHO, DA SUA LUA <span style="color:var(--am)">♡</span><br><br>CONTINUE ESCREVENDO ESSA HISTÓRIA.</footer>
</div>
<script>
const $=id=>document.getElementById(id);
function quiz(answer){$('quizR').textContent=answer==='Lua & Meu Mundo'?'Acertou! Essa é a nossa combinação favorita. 💜':'Boa resposta! Mas Lua & Meu Mundo tem um lugar especial por aqui. 🌙';}
const prompts=['Quem provavelmente dormiria durante um filme?','Quem mandaria mais memes durante o dia?','Quem escolheria jogar só mais uma partida?','Quem é mais provável de esquecer onde colocou o celular?'];
let pi=0;function nextChallenge(a){$('challengeR').textContent='Resposta oficial: '+a+'! Agora é a vez do outro defender sua escolha. 😄';pi=(pi+1)%prompts.length;$('challenge').textContent=prompts[pi];}
const missions=['Mandem uma música que lembre um ao outro.','Cada um conte uma lembrança favorita de vocês.','Façam uma selfie juntos, mesmo que seja por chamada.','Digam três coisas que admiram um no outro.','Escolham um jogo para jogar juntos hoje.','Inventem um nome para a próxima fase da história de vocês.'];
function newMission(){$('mission').textContent=missions[Math.floor(Math.random()*missions.length)];}
let cells=Array(9).fill(''),turn='X',finished=false;
function drawBoard(){$('board').innerHTML='';cells.forEach((v,i)=>{const b=document.createElement('button');b.className='cell';b.textContent=v;b.disabled=!!v||finished;b.onclick=()=>playCell(i);$('board').appendChild(b)});$('turn').textContent=finished?'Partida encerrada':'Vez de '+turn;}
function playCell(i){if(cells[i]||finished)return;cells[i]=turn;const wins=[[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];const won=wins.some(line=>line.every(n=>cells[n]===turn));if(won){finished=true;$('boardR').textContent='🎉 '+turn+' venceu!';}else if(cells.every(Boolean)){finished=true;$('boardR').textContent='Empate! Mais uma?';}else turn=turn==='X'?'O':'X';drawBoard();}
function resetBoard(){cells=Array(9).fill('');turn='X';finished=false;$('boardR').textContent='';drawBoard();}drawBoard();
const defaultPet={hunger:70,energy:70,love:70};let pet;
try{pet={...defaultPet,...JSON.parse(localStorage.getItem('luaMeuMundoPet')||'{}')}}catch(e){pet={...defaultPet}}
function savePet(){try{localStorage.setItem('luaMeuMundoPet',JSON.stringify(pet))}catch(e){}}
function renderPet(){[['hunger','hungerN','hungerB'],['energy','energyN','energyB'],['love','loveN','loveB']].forEach(([k,n,b])=>{$(n).textContent=pet[k]+'%';$(b).style.width=pet[k]+'%'});$('petFace').textContent=pet.love>80?'😻':pet.energy<25?'😴':pet.hunger<25?'🥺':'🐱';}
function care(action){let msg='';if(action==='feed'){pet.hunger=Math.min(100,pet.hunger+22);pet.energy=Math.max(0,pet.energy-3);msg='Nhac nhac! Ametista adorou a comidinha. 🍓'}if(action==='play'){if(pet.energy<15){msg='Ametista está cansadinha. Deixem ela descansar primeiro. 🌙'}else{pet.love=Math.min(100,pet.love+15);pet.energy=Math.max(0,pet.energy-18);pet.hunger=Math.max(0,pet.hunger-8);msg='Que diversão! Ametista brincou muito com vocês. 🧶'}}if(action==='love'){pet.love=Math.min(100,pet.love+18);msg='Purrr… Ametista está se sentindo muito amada. 💗'}if(action==='sleep'){pet.energy=Math.min(100,pet.energy+28);msg='Shhh… Ametista tirou uma sonequinha gostosa. 🌙'}renderPet();savePet();$('petMsg').textContent=msg;}
renderPet();
function reveal(){$('secret').classList.add('show');$('unlockBtn').textContent='MENSAGEM DESBLOQUEADA ✓';}
</script></body></html>
